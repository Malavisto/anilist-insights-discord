[Unit]
Description=AniList Discord Bot Service
After=network.target

[Service]
# Node has no sd_notify support, so "notify" would fail the unit after a startup timeout
Type=simple
# Set these to the user that runs the bot (must own /opt/anilist-discord)
#User=botuser
#Group=botuser
WorkingDirectory=/opt/anilist-discord
Environment="NODE_ENV=production"
ExecStart=pnpm start
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
